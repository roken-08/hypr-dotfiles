# Editor / swap files
*.swp
*.swo
*~
.DS_Store

*.log
hyprland*.log
core
*.core

.cache/
*/.config/*/cache/
zsh/.zsh_history
zsh/.zcompdump*

nvim/.config/nvim/.luarc.json
nvim/.config/nvim/spell/

.stow-local-ignore

Screenshots/*-draft.png
Screenshots/tmp*

# orrery-theme output (rendered from theme/.config/orrery/templates)
theme/.config/orrery/current/
theme/.config/orrery/current.next/
theme/.config/orrery/shell.json
# more per-machine state that lives next to it (~/.config/orrery is the stow link)
theme/.config/orrery/menu.local.jsonc
theme/.config/orrery/defaults/
theme/.config/orrery/ui/
__pycache__/
*.pyc

# themes: the rice ships these four; any other folder under themes/ is the
# user's own (made by hand or by an agent) and stays on their machine
theme/.config/orrery/themes/*
!theme/.config/orrery/themes/eclipse/
!theme/.config/orrery/themes/zenith/
!theme/.config/orrery/themes/catppuccin-mocha/
!theme/.config/orrery/themes/cassini/
# the maintainer's own rules for the /orrery skill (see SKILL.md); not published
theme/.config/orrery/skills/orrery/MAINTAINER.md
hyprland/.config/hypr/modules/monitors.local.lua
