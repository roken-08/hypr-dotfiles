#!/usr/bin/env bash
# orrery-nightlight toggle|on|off|status — warm screen tint via hyprsunset.
TEMP="${ORRERY_NIGHTLIGHT_TEMP:-4000}"
# tell the shell right away (it only polls every 10 s): the bar icon follows at once
tell() { command -v qs >/dev/null 2>&1 && qs ipc call nightlight state "$1" >/dev/null 2>&1; }
on()  { pgrep -x hyprsunset >/dev/null || setsid -f hyprsunset -t "$TEMP" >/dev/null 2>&1; tell on; }
off() { pkill -x hyprsunset 2>/dev/null; tell off; }
case "${1:-toggle}" in
    on) on ;; off) off ;;
    toggle) if pgrep -x hyprsunset >/dev/null; then off; else on; fi ;;
    status) pgrep -x hyprsunset >/dev/null && echo on || echo off ;;
    *) echo "usage: orrery-nightlight toggle|on|off|status" >&2; exit 1 ;;
esac
