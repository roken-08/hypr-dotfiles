#!/usr/bin/env bash
# orrery-float <command...> — run a command in a floating, centred terminal
# (class orrery-float; the window rule is in modules/windowrules.lua). The
# terminal stays open on failure so the output can be read; Enter closes.
[[ $# -gt 0 ]] || { echo "usage: orrery-float <command...>" >&2; exit 1; }
term="${TERMINAL:-$(cat "$HOME/.config/orrery/defaults/terminal" 2>/dev/null || echo kitty)}"
script="$*; s=\$?; printf '\n[exit %s] press Enter to close' \"\$s\"; read -r"
case "$term" in
    kitty)     exec setsid -f kitty -o remember_window_size=no --class orrery-float --title "$1" -e bash -lc "$script" ;;
    alacritty) exec setsid -f alacritty --class orrery-float --title "$1" -e bash -lc "$script" ;;
    *)         exec setsid -f "$term" -e bash -lc "$script" ;;
esac
