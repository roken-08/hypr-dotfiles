; Spotify colours for the current orrery-theme ({{ name }}), for Spicetify.
; Rendered by orrery-theme into current/; installed as the "hypr" theme.
[hypr]
text               = {{ fg | strip }}
subtext            = {{ accent_mid | strip }}
main               = {{ bg1 | strip }}
main-elevated      = {{ bg2 | strip }}
sidebar            = {{ bg0 | strip }}
player             = {{ bg0 | strip }}
card               = {{ bg2 | strip }}
shadow             = 000000
main-secondary     = {{ bg2 | strip }}
highlight          = {{ bg3 | strip }}
highlight-elevated = {{ bg4 | strip }}
selected-row       = {{ fg | strip }}
button             = {{ accent_bright | strip }}
button-active      = {{ accent_light | strip }}
button-secondary   = {{ accent_mid | strip }}
button-disabled    = {{ bg4 | strip }}
nav-active         = {{ bg3 | strip }}
nav-active-text    = {{ fg | strip }}
play-button        = {{ accent_bright | strip }}
tab-active         = {{ bg3 | strip }}
notification       = {{ bg2 | strip }}
notification-error = {{ critical | strip }}
playback-bar       = {{ accent_bright | strip }}
misc               = {{ accent_dim | strip }}
