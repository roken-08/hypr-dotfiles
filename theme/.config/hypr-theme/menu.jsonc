{
  // The menu (SUPER+SPACE). Keys are ids; a dot makes a child: "style.bar.top"
  // sits under "style.bar" under "style". Fields:
  //   icon, label      the row. icon: a Material Symbols name ("wifi", "palette" —
//                    fonts.google.com/icons; new names go in quickshell's
//                    Commons/icons/names.txt + build.py) or any glyph, e.g. a Nerd Font one.
//                    description: extra words the search matches.
  //   action           shell command, run detached. Omit → the row opens its children.
  //   keep             true: the menu stays open after the action (toggles) and re-reads state.
  //   checked          state key → ✓ when true ("!key" negates). value: state key shown as text.
  //   when             state key → the row is hidden when false.
  //   input            the search box becomes an input; Enter runs action with {} replaced.
  //   provider         rows come from hypr-menu-data: agents, keybindings, packages,
  //                    reminders, about — or from the shell: widgets.
  //   close            false: an action row that keeps the menu open without re-reading state.
  // State keys come from the shell (theme, light, bar.*, caffeine, dnd, laptop, widget.*)
  // and from hypr-menu-data (nightlight, gaps, opacity, hibernate, terminal, browser, agent).
  // A file next to this one, menu.local.jsonc, overlays it by id (same fields; new ids
  // append). Whole-line // comments only.

  "apps":    {"icon":"apps","label":"Apps","description":"launcher applications","action":"qs ipc call launcher toggle"},
  "style":   {"icon":"style","label":"Style"},
  "toggle":  {"icon":"toggle_on","label":"Toggle"},
  "setup":   {"icon":"settings","label":"Setup","description":"settings config"},
  "agents":  {"icon":"󰚩","label":"Agents","description":"ai claude codex"},
  "learn":   {"icon":"school","label":"Learn","description":"help docs keys"},
  "remind":  {"icon":"alarm","label":"Reminder"},
  "system":  {"icon":"power_settings_new","label":"System","description":"power"},

  // Style
  "style.theme":      {"icon":"palette","label":"Theme","value":"theme","action":"hypr-theme-menu theme"},
  "style.wallpaper":  {"icon":"wallpaper","label":"Wallpaper","value":"wallpaper","action":"hypr-theme-menu wallpaper"},
  "style.bar":        {"icon":"toolbar","label":"Bar"},
  "style.bar.pill":     {"icon":"history","label":"Legacy","description":"pill skin classic waybar look","checked":"bar.pill","action":"qs ipc call bar style pill","keep":true},
  "style.bar.floating": {"icon":"flip_to_front","label":"Floating","description":"minimal skin inset rounded","checked":"bar.floating","action":"qs ipc call bar style floating","keep":true},
  "style.bar.minimal":  {"icon":"horizontal_rule","label":"Minimal","description":"flat strip omarchy flush edge","checked":"bar.minimal","action":"qs ipc call bar style minimal","keep":true},
  "style.bar.top":      {"icon":"align_vertical_top","label":"Top","checked":"bar.top","action":"qs ipc call bar position top","keep":true},
  "style.bar.bottom":   {"icon":"align_vertical_bottom","label":"Bottom","checked":"bar.bottom","action":"qs ipc call bar position bottom","keep":true},
  "style.bar.left":     {"icon":"align_horizontal_left","label":"Left","checked":"bar.left","action":"qs ipc call bar position left","keep":true},
  "style.bar.right":    {"icon":"align_horizontal_right","label":"Right","checked":"bar.right","action":"qs ipc call bar position right","keep":true},
  "style.bar.transparent": {"icon":"opacity","label":"Transparent (floating / minimal)","checked":"bar.transparent","action":"qs ipc call bar transparent","keep":true},
  "style.bar.widgets":  {"icon":"widgets","label":"Widgets","description":"enable disable modules","provider":"widgets"},
  "style.bar.reset":    {"icon":"restart_alt","label":"Reset widget order","description":"default layout restore","action":"qs ipc call bar reset","keep":true},
  "style.dock":       {"icon":"dock_to_bottom","label":"Dock","description":"taskbar launcher pinned apps"},
  "style.dock.show":        {"icon":"dock_to_bottom","label":"Show dock","checked":"dock","action":"qs ipc call dock toggle","keep":true},
  "style.dock.always":      {"icon":"visibility","label":"Always visible","description":"windows keep clear of it","checked":"dock.mode:always","action":"qs ipc call dock mode always","keep":true},
  "style.dock.intellihide": {"icon":"select_window","label":"Hide when a window covers it","description":"intellihide","checked":"dock.mode:intellihide","action":"qs ipc call dock mode intellihide","keep":true},
  "style.dock.autohide":    {"icon":"visibility_off","label":"Auto-hide","description":"touch the screen edge to show","checked":"dock.mode:autohide","action":"qs ipc call dock mode autohide","keep":true},
  "style.dock.bottom":      {"icon":"dock_to_bottom","label":"Bottom","checked":"dock.position:bottom","action":"qs ipc call dock position bottom","keep":true},
  "style.dock.left":        {"icon":"dock_to_left","label":"Left","checked":"dock.position:left","action":"qs ipc call dock position left","keep":true},
  "style.dock.right":       {"icon":"dock_to_right","label":"Right","checked":"dock.position:right","action":"qs ipc call dock position right","keep":true},
  "style.dock.top":         {"icon":"vertical_align_top","label":"Top","checked":"dock.position:top","action":"qs ipc call dock position top","keep":true},
  "style.dock.transparent": {"icon":"opacity","label":"Transparent","checked":"dock.transparent","action":"qs ipc call dock transparent","keep":true},
  "style.dock.pins":        {"icon":"push_pin","label":"Pinned apps","description":"add remove apps favourites","provider":"dock.pins"},
  "style.font":       {"icon":"font_download","label":"Font","description":"typeface family monospace","value":"font","provider":"fonts"},
  "style.text":       {"icon":"format_size","label":"Text size","description":"font size scale bigger smaller","value":"textsize"},
  "style.text.10":    {"icon":"format_size","label":"10 px","checked":"textsize:10","action":"hypr-text-size 10","keep":true},
  "style.text.11":    {"icon":"format_size","label":"11 px","checked":"textsize:11","action":"hypr-text-size 11","keep":true},
  "style.text.12":    {"icon":"format_size","label":"12 px  (default)","checked":"textsize:12","action":"hypr-text-size 12","keep":true},
  "style.text.13":    {"icon":"format_size","label":"13 px","checked":"textsize:13","action":"hypr-text-size 13","keep":true},
  "style.text.14":    {"icon":"format_size","label":"14 px","checked":"textsize:14","action":"hypr-text-size 14","keep":true},
  "style.text.16":    {"icon":"format_size","label":"16 px","checked":"textsize:16","action":"hypr-text-size 16","keep":true},
  "style.text.18":    {"icon":"format_size","label":"18 px","checked":"textsize:18","action":"hypr-text-size 18","keep":true},
  "style.scale":      {"icon":"fit_screen","label":"Display scale","description":"monitor hidpi zoom resolution","value":"scale"},
  "style.scale.1":    {"icon":"fit_screen","label":"1×","checked":"scale:1","action":"hypr-scale 1","keep":true},
  "style.scale.125":  {"icon":"fit_screen","label":"1.25×","checked":"scale:1.25","action":"hypr-scale 1.25","keep":true},
  "style.scale.15":   {"icon":"fit_screen","label":"1.5×","checked":"scale:1.5","action":"hypr-scale 1.5","keep":true},
  "style.scale.16":   {"icon":"fit_screen","label":"1.6×","checked":"scale:1.6","action":"hypr-scale 1.6","keep":true},
  "style.scale.2":    {"icon":"fit_screen","label":"2×","checked":"scale:2","action":"hypr-scale 2","keep":true},
  "style.scale.reset":{"icon":"fit_screen","label":"Back to monitors.lua","action":"hypr-scale reset","keep":true},
  "style.look":       {"icon":"tune","label":"Edit look & feel","description":"gaps borders rounding animations blur","action":"hypr-edit ~/.config/hypr/modules/decorations.lua"},

  // Toggle
  "toggle.caffeine":   {"icon":"coffee","label":"Caffeine","description":"stay awake idle","checked":"caffeine","action":"qs ipc call caffeine toggle","keep":true},
  "toggle.dnd":        {"icon":"do_not_disturb_on","label":"Do not disturb","description":"notifications silence","checked":"dnd","action":"qs ipc call notifications dnd","keep":true},
  "toggle.nightlight": {"icon":"nightlight","label":"Night light","description":"warm blue light","checked":"nightlight","action":"hypr-nightlight toggle","keep":true},
  "toggle.bar":        {"icon":"toolbar","label":"Bar","checked":"!bar.hidden","action":"qs ipc call bar visible","keep":true},
  "toggle.battery":    {"icon":"battery_full","label":"Battery percentage","when":"laptop","checked":"bar.battery","action":"qs ipc call bar battery","keep":true},
  "toggle.gaps":       {"icon":"margin","label":"Window gaps","checked":"gaps","action":"hypr-toggle gaps","keep":true},
  "toggle.opacity":    {"icon":"opacity","label":"Window transparency","checked":"opacity","action":"hypr-toggle opacity","keep":true},

  // Setup — the Lua files open in the editor and are validated on save
  "setup.monitors":    {"icon":"monitor","label":"Monitors","description":"display scale","action":"hypr-edit ~/.config/hypr/modules/monitors.lua"},
  "setup.keybindings": {"icon":"keyboard","label":"Keybindings","action":"hypr-edit ~/.config/hypr/modules/binds.lua"},
  "setup.input":       {"icon":"mouse","label":"Input","description":"keyboard touchpad mouse","action":"hypr-edit ~/.config/hypr/modules/decorations.lua"},
  "setup.autostart":   {"icon":"rocket_launch","label":"Autostart","action":"hypr-edit ~/.config/hypr/modules/autostart.lua"},
  "setup.rules":       {"icon":"rule","label":"Window rules","action":"hypr-edit ~/.config/hypr/modules/windowrules.lua"},
  "setup.shell":       {"icon":"settings_applications","label":"Shell settings","description":"shell.json bar layout","action":"hypr-edit ~/.config/hypr-theme/shell.json"},
  "setup.wifi":        {"icon":"wifi","label":"Wi-Fi","action":"qs ipc call panels open network"},
  "setup.bluetooth":   {"icon":"bluetooth","label":"Bluetooth","action":"qs ipc call panels open bluetooth"},
  "setup.audio":       {"icon":"volume_up","label":"Audio","description":"volume sound output","action":"qs ipc call panels open audio"},
  "setup.power":       {"icon":"bolt","label":"Power profile","action":"qs ipc call panels open power"},
  "setup.restart":     {"icon":"restart_alt","label":"Restart shell","description":"bar reload refresh","action":"~/.config/hypr/scripts/shell.sh restart"},
  "setup.doctor":      {"icon":"stethoscope","label":"Diagnostics","description":"doctor logs health","action":"hypr-float 'hypr-doctor --print | less -R'"},
  "setup.defaults":    {"icon":"check_circle","label":"Defaults"},
  "setup.defaults.agent":    {"icon":"󰚩","label":"Coding agent","value":"agent","provider":"agents.default"},
  "setup.defaults.terminal": {"icon":"terminal","label":"Terminal","value":"terminal"},
  "setup.defaults.terminal.kitty":     {"icon":"terminal","label":"kitty","checked":"terminal:kitty","action":"hypr-default terminal kitty","keep":true},
  "setup.defaults.terminal.alacritty": {"icon":"terminal","label":"alacritty","checked":"terminal:alacritty","action":"hypr-default terminal alacritty","keep":true},
  "setup.defaults.browser":  {"icon":"language","label":"Browser","value":"browser"},
  "setup.defaults.browser.zen":      {"icon":"language","label":"Zen","checked":"browser:zen-browser","action":"hypr-default browser zen-browser","keep":true},
  "setup.defaults.browser.firefox":  {"icon":"language","label":"Firefox","checked":"browser:firefox","action":"hypr-default browser firefox","keep":true},
  "setup.defaults.browser.chromium": {"icon":"language","label":"Chromium","checked":"browser:chromium","action":"hypr-default browser chromium","keep":true},

  // Agents
  "agents.launch":  {"icon":"󱚝","label":"Launch default agent","value":"agent","action":"hypr-agent launch"},
  "agents.list":    {"icon":"󰚩","label":"Launch…","provider":"agents"},
  "agents.usage":   {"icon":"data_usage","label":"Usage & limits","action":"qs ipc call panels open agents"},
  "agents.default": {"icon":"check_circle","label":"Default agent","value":"agent","provider":"agents.default"},
  "agents.skills":  {"icon":"extension","label":"Link /hypr skill into agents","action":"hypr-float hypr-agent skills install"},

  // Learn
  "learn.keys":     {"icon":"keyboard","label":"Keybindings","description":"shortcuts keys","provider":"keybindings"},
  "learn.readme":   {"icon":"description","label":"Rice README","action":"hypr-float nvim -R ~/hypr-dotfiles/README.md"},
  "learn.hyprland": {"icon":"menu_book","label":"Hyprland wiki","action":"xdg-open https://wiki.hypr.land/"},
  "learn.arch":     {"icon":"article","label":"Arch wiki","action":"xdg-open https://wiki.archlinux.org/"},
  "learn.about":     {"icon":"info","label":"About this rice","description":"version uptime kernel","provider":"about"},
  "learn.quickshell": {"icon":"code","label":"Quickshell docs","action":"xdg-open https://quickshell.org/docs/v$(qs --version | cut -d' ' -f2)/types/"},



  // Reminder
  "remind.set":   {"icon":"alarm_add","label":"Set a reminder","description":"timer notify","input":"minutes message  (e.g. 15 pick up jack)","action":"hypr-remind {}"},
  "remind.show":  {"icon":"schedule","label":"Pending","provider":"reminders"},
  "remind.clear": {"icon":"delete_sweep","label":"Clear all","action":"hypr-remind clear"},

  // System
  "system.lock":      {"icon":"lock","label":"Lock","action":"~/.config/hypr/scripts/lock.sh"},
  "system.suspend":   {"icon":"bedtime","label":"Suspend","description":"sleep","action":"systemctl suspend"},
  "system.hibernate": {"icon":"mode_standby","label":"Hibernate","when":"hibernate","action":"systemctl hibernate"},
  "system.logout":    {"icon":"logout","label":"Logout","action":"hyprctl dispatch exit"},
  "system.reboot":    {"icon":"restart_alt","label":"Reboot","action":"systemctl reboot"},
  "system.shutdown":  {"icon":"power_settings_new","label":"Shutdown","description":"power off","action":"systemctl poweroff"}
}
